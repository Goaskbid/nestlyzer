// Nestlyzer static site build: bundles the app shell and renders the SEO pages.
//   node build/build_site.mjs
import fs from 'node:fs';
import crypto from 'node:crypto';
import zlib from 'node:zlib';
import path from 'node:path';
import { createRequire } from 'node:module';
import { fileURLToPath } from 'node:url';
import { buildInsights } from './insights.mjs';
import { worldPage } from './world_page.mjs';
import { policyPages } from './policy_pages.mjs';
const require = createRequire(import.meta.url);
const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const terser = require('terser');
const esbuild = require('esbuild');
const topojson = require('topojson-client');
const Engine = require(path.join(ROOT, 'src/engine.js'));
const NestData = require(path.join(ROOT, 'src/data.js'));

const VERSION = process.env.NZ_VERSION || '2.15.14';
const SITE = 'https://nestlyzer.com';
const read = (p) => fs.readFileSync(path.join(ROOT, p), 'utf8');
/* Static pages: emoji in text become our inline line icons at build time (2.10.1); the app swaps the rest at run time. */
const EMOJI_ALL = JSON.parse(fs.readFileSync(path.join(ROOT, 'build/icons/emoji_icons.json'), 'utf8'));
const EMOJI_RX = new RegExp('(' + Object.keys(EMOJI_ALL.map).join('|') + ')️?', 'g');
const emojiSvg = (html, lazy) => {
  const keep = []; // scripts, styles, titles, options and textareas stay exactly as written
  const h = html.replace(/<(script|style|title|option|textarea)\b[\s\S]*?<\/\1>/gi, (m) => '\u0000' + (keep.push(m) - 1) + '\u0000');
  const out = h.split(/(<[^>]*>)/).map((part) => part.charAt(0) === '<' ? part : part.replace(EMOJI_RX, (m, e) => lazy ? m : `<span class="ei" aria-hidden="true"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${EMOJI_ALL.icons[EMOJI_ALL.map[e]]}</svg></span>`)).join('');
  return out.replace(/\u0000(\d+)\u0000/g, (m, n) => keep[+n]);
};
const write = (p, s) => { const f = path.join(ROOT, p); fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, s); };
const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const slugify = (s) => NestData.translit(String(s || '')).replace(/[øØ]/g, 'o').replace(/[æÆ]/g, 'ae').replace(/[łŁ]/g, 'l').replace(/[đĐð]/g, 'd').replace(/þ/g, 'th').replace(/œ/g, 'oe').replace(/ı/g, 'i').normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/ß/g, 'ss').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const fmtInt = (v) => Number.isFinite(v) ? Math.round(v).toLocaleString('en-GB') : '–';
const fmt = (v, d = 0) => Number.isFinite(v) ? Number(v).toLocaleString('en-GB', { maximumFractionDigits: d, minimumFractionDigits: d }) : '–';
const signed = (v, d = 1) => Number.isFinite(v) ? (v > 0 ? '+' : '') + fmt(v, d) : '–';
const FLAG = { EL: 'GR', UK: 'GB' };
const PICON = Object.fromEntries(Object.entries(JSON.parse(fs.readFileSync(path.join(ROOT, 'build/icons/icons.json'), 'utf8')))
  .map(([k, v]) => [k, String(v).replace(/\s*\/>\s*/g, '/>').replace(/>\s+</g, '><')]));  // same SVG, no whitespace between elements
// stroke styling for .pico lives in base.css (every built page loads it), so each icon carries only its paths
const ico = (k, size = 20) => `<svg class="pico" width="${size}" height="${size}" viewBox="0 0 24 24" aria-hidden="true">${PICON[k] || PICON.self_fit}</svg>`;
const flagImg = (cc, h = 14) => `<img class="flag" src="/assets/flags/${cc.toLowerCase()}.png" alt="" width="${Math.round(h * 4 / 3)}" height="${h}" loading="lazy" decoding="async">`;
const flag = (cc) => { cc = FLAG[cc] || cc; return String.fromCodePoint(0x1F1E6 + cc.charCodeAt(0) - 65, 0x1F1E6 + cc.charCodeAt(1) - 65); };
const km = (a, b) => { const R = 6371, la1 = a[1] * Math.PI / 180, la2 = b[1] * Math.PI / 180, dl = la2 - la1, dn = (b[0] - a[0]) * Math.PI / 180; const h = Math.sin(dl / 2) ** 2 + Math.cos(la1) * Math.cos(la2) * Math.sin(dn / 2) ** 2; return 2 * R * Math.asin(Math.sqrt(h)); };
const stripParen = (s) => String(s || '').replace(/\s*\(.*?\)\s*/g, ' ').replace(/,\s*(Stadt|Markt|Gemeinde|Landeshauptstadt|Hansestadt)$/i, '').trim();
const TODAY = new Date().toISOString().slice(0, 10);

// ------------------------------------------------------------------ data
const meta = JSON.parse(read('data/meta.json'));
const engine = new Engine(meta, { method: 'v2' });
const cfg = meta.config;
const countries = meta.countries.slice().sort((a, b) => a.name.localeCompare(b.name));   // 2.15: no country pinned first (global site)
const SH = {};
const KG = { Csa: 'Mediterranean, hot summer', Csb: 'Mediterranean, warm summer', Cfa: 'Humid subtropical', Cfb: 'Oceanic', Cfc: 'Subpolar oceanic', Dfa: 'Continental, hot summer', Dfb: 'Continental, warm summer', Dfc: 'Subarctic', Dsb: 'Continental, dry warm summer', Dsc: 'Subarctic, dry summer', BSh: 'Hot semi-arid', BSk: 'Cold semi-arid', BWh: 'Hot desert', BWk: 'Cold desert', ET: 'Alpine tundra', EF: 'Ice cap' };
for (const c of countries) {
  const sh = JSON.parse(read(`data/c/${c.cc}.json`)), all = NestData.hydrate(sh);
  let xs = null; try { xs = JSON.parse(read(`data/x/${c.cc}.json`)); } catch (e) { xs = null; }
  if (xs) { const NM = { kg: 1, lake: 1, river: 1, port: 1, iport: 1, mport: 1, chem: 1, border: 1, metro: 1, land: 1, sea: 1, shore: 1 }; all.forEach((r, i) => { const o = {}; for (const k in xs.cols) { const v = xs.cols[k][i]; if (v != null) o[k] = NM[k] ? xs.strs[v] : v; } r.x = o; }); }
  if (sh.world && sh.world.whole) { const wh = new Set(sh.world.whole.map(String)); all.forEach((r) => { if (wh.has(String(r.oid))) r.whole = true; }); }
  SH[c.cc] = { sh, recs: all.filter((r) => !r.superseded), capital: xs && xs.capital };
}
const profiles = [...cfg.order, ...(cfg.hhDormant || []).filter((k) => k === 'single')].filter((k) => engine.profiles[k]);   // 2.15.5: 'single' was merged but its country pages stay (their URLs are indexed)
const WORLD = cfg.worldCountries || [];
const CONTINENTS = [['North America', ['CA', 'MX', 'US']], ['Central America', ['CR', 'PA']], ['South America', ['AR', 'BR', 'CL', 'CO', 'UY']], ['Asia', ['CN', 'HK', 'IN', 'ID', 'JP', 'KZ', 'MY', 'PH', 'KR', 'SG', 'TW', 'TH', 'VN']], ['Oceania', ['AU', 'NZ']], ['Middle East', ['IL', 'QA', 'SA', 'AE']], ['Africa', ['EG', 'MA', 'ZA']]];
function countryGroupsB() {
  const used = new Set(), out = CONTINENTS.map(([g, ccs]) => [g, countries.filter((c) => ccs.includes(c.cc) && used.add(c.cc))]).filter(([, cs]) => cs.length);
  return [['Europe', countries.filter((c) => !used.has(c.cc))], ...out];
}

/* the landing picture holds eight profiles; the others show the closest of those (by weights) */
function heroNear(k, list) {
  const w = engine.profiles[k].weights || {}, cats = [...new Set([...Object.keys(w), ...list.flatMap((h) => Object.keys(engine.profiles[h].weights || {}))])];
  const v = (o) => cats.map((c) => o[c] || 0), a = v(w), na = Math.hypot(...a);
  let best = list[0], bs = -1;
  for (const h of list) { const b = v(engine.profiles[h].weights || {}), s = a.reduce((t, x, i) => t + x * b[i], 0) / (na * Math.hypot(...b) || 1); if (s > bs) { bs = s; best = h; } }
  return best;
}
const WHO8 = ['young_family', 'pensioner', 'remote', 'student', 'commuter', 'single_parent', 'expat_professional', 'coastal'];
// the globe on the start page holds these ten; the other households light it with the closest of them
const HERO_PROFILES = [...WHO8, 'business_owner', 'digital_native'];
const WHO_MORE = () => profiles.filter((k) => !WHO8.includes(k) && k !== 'self_fit').map((k) => [k, engine.profiles[k].name, heroNear(k, HERO_PROFILES)]);
// ------------------------------------------------------------------ the data catalogue (app modal and method page)
function buildCatalogue() {
  const C = JSON.parse(read('build/content/catalogue.json'));
  const scored = meta.factors.filter((x) => x.score_role === 'scored' || x.score_role === 'scored_access_proxy');
  const cover = {};
  for (const c of countries) for (const r of SH[c.cc].recs) { const fr = r.factorRaw || {}, fs = r.factorScores || {}; for (const f of scored) if (Number.isFinite(fr[f.id]) || Number.isFinite(fs[f.id])) (cover[f.id] = cover[f.id] || new Set()).add(c.cc); }
  const items = C.items.slice();
  for (const f of scored) {
    const cs = cover[f.id] ? [...cover[f.id]] : []; if (!cs.length) continue;
    items.push({ g: 'factors', label: f.name, level: 'Municipality', cover: cs.length >= countries.length ? 'All ' + countries.length + ' countries' : cs.map((cc) => (countries.find((c) => c.cc === cc) || {}).name || cc).sort().join(', '), src: f.source_name || '', url: f.source_url || '', period: f.source_period || '', score: 'yes (' + (meta.categoryLabels[f.category] || f.category).replace('Environment and climate', 'Green space').toLowerCase() + ')' });
  }
  return { note: C.note, items, missing: C.missing || [] };
}
const CATALOGUE = buildCatalogue();
function catalogueTable() {
  const py = (meta.population || {}).year || 2024, by = (meta.population || {}).base_year || py - 5;
  const per = (x) => String(x || '').replace('BASEYEAR', by).replace('POPYEAR', py);
  const heads = [['built', 'Built in, for every municipality'], ['factors', 'Scored factors'], ['country', 'Country facts'], ['live', 'Loaded live when you open a place']];
  return heads.map(([g, h]) => { const it = CATALOGUE.items.filter((o) => o.g === g); if (!it.length) return ''; return `<h3>${esc(h)}</h3><div style="overflow-x:auto"><table class="table stack"><thead><tr><th>What</th><th>Level</th><th>Countries</th><th>Source and year</th><th>In the score</th></tr></thead><tbody>${it.map((o) => `<tr><td>${esc(o.label)}</td><td>${esc(o.level)}</td><td>${esc(o.cover)}</td><td>${o.url ? `<a href="${esc(o.url)}" rel="noopener">${esc(o.src)}</a>` : esc(o.src)}${o.period ? ', ' + esc(per(o.period)) : ''}</td><td>${esc(o.score)}</td></tr>`).join('')}</tbody></table></div>`; }).join('') +
    (CATALOGUE.missing.length ? `<h3>Coming next</h3><ul>${CATALOGUE.missing.map((m) => `<li>${esc(m)}</li>`).join('')}</ul>` : '');
}
const TOTAL = fmtInt(countries.reduce((a, c) => a + c.n, 0));
const PROFILE_COPY = {"young_family": "Families with young children: safe streets, schools and childcare nearby, room to grow and costs that leave something over.", "low_income": "Households on a tight budget: low housing pressure, modest taxes, basic services and a job market within reach.", "low_income_family": "Families on a tight budget: a solid family base and safety first, then the lowest costs that still work day to day.", "single_parent": "One parent, one income: childcare, safety, short everyday trips and costs that stay manageable.", "pensioner": "Couples after work: good health care, calm, safety, easy daily errands and a fair tax burden.", "single_pensioner": "Living alone in retirement: doctors close by, safety, services within walking distance and manageable costs.", "early_retiree": "Stopping work early: a pleasant setting, good health care, sensible taxes and a city within reach, without needing a local job market.", "single": "One working adult: jobs, a real centre, services and safety; a low tax rate alone does not win.", "young_professional": "Early in a career: access to a big job market, city services and transport at a cost that still works.", "dinks": "Two incomes, no children: job depth, restaurants and culture, quick connections to a larger centre.", "remote": "Working from home: calm surroundings, reasonable costs, good local services and a station or airport within reach.", "commuter": "Daily trips to work: a big job centre close by, plus calm and costs at home. Distances are straight lines, not timetables.", "car_free": "Life without a car: dense services, a centre within reach and public transport; remote places cannot win on scenery.", "student": "Studying: a university within reach, the right language area, affordable living and young services.", "first_home": "Buying a first home: affordable prices, new housing being built, a stable population and jobs nearby.", "budget": "Moving on the lowest budget: costs and housing pressure first, with enough services and access to stay practical.", "urban": "City life: amenities, jobs, transport and density; small remote places are left out.", "expat_professional": "Moving abroad for work: international jobs, services, a hub airport and safety. International-school data is not in yet.", "healthcare_first": "Health comes first: doctors and hospitals within reach, calm and safety, with practical services around.", "nature": "Nature first: open land, low density, a good climate and the basics nearby.", "rural_value": "Value in the countryside: lower costs and open land in smaller places that still have basic services.", "hnw": "A large budget: low taxes matter, but only together with safety, health care, services and quality of life.", "swiss_lottery": "A windfall: where it goes furthest after tax and still buys a good life. Tax detail is only joined for Switzerland.", "climate": "Planning for a changing climate: environment, water, safety, health care and long-term comfort.", "coastal": "Life by the water: the sea or a large lake close by first (Lake Zurich and Lake Ontario count as much as the Atlantic), then calm, health care, safety and costs. Places with no sea or large lake within 60 km are honestly left out.", "business_owner": "Running a company: a big market and talent within reach, an airport and a city for clients, taxes where they are measured, and safety. The national business climate is compared country by country.", "digital_native": "Young and online: city life, a young crowd, quick trips, jobs and costs that leave room."};
const TILE_BLURB = { commuter: 'Short, reliable trips to a big job centre, plus calm and costs', dinks: 'Two incomes, no children: jobs, city life and quick connections', expat_professional: 'International jobs, a hub airport and services that work in English', swiss_lottery: 'Where a windfall goes furthest after tax, with quality of life (tax detail in Switzerland)', hnw: 'Tax, safety, privacy and services for a large household budget', remote: 'Work from home: calm, costs, lifestyle and a station or airport within reach' };
const SHORT = { pensioner: 'Retirees', single_parent: 'Single parent', young_professional: 'Young professional', hnw: 'High net worth', expat_professional: 'Expat professional' };   // 2.15.6: start chips fit on a phone
const KEY_PROFILES = ['young_family', 'pensioner', 'remote', 'commuter', 'single', 'budget'];
const AUDIENCE = {
  outdoor: 'outdoor and mountain lovers', cross_border: 'cross-border commuters', young_family: 'young families', low_income: 'low-income households', low_income_family: 'low-income families', single_parent: 'single parents', pensioner: 'retired couples', single_pensioner: 'single pensioners', early_retiree: 'early retirees', single: 'single professionals', young_professional: 'young professionals', dinks: 'couples without children (DINKs)', remote: 'remote workers', commuter: 'commuters', car_free: 'car-free households', student: 'students', first_home: 'first-time home buyers', budget: 'movers on a budget', urban: 'city lovers', expat_professional: 'expat professionals', healthcare_first: 'people who put healthcare first', nature: 'nature lovers', rural_value: 'rural value seekers', hnw: 'high-net-worth movers', swiss_lottery: 'lottery winners', climate: 'climate-conscious movers', coastal: 'people who want to live by the sea', business_owner: 'business owners', digital_native: 'digital natives'
};
const PSLUG = Object.fromEntries(profiles.map((k) => [k, slugify(engine.profiles[k].name)]));

function regionLevel(cc) {
  if (cc === 'CH') return 'CH';
  if ((cfg.regionLevel || {})[cc]) return cfg.regionLevel[cc];
  const n1 = new Set(), n2 = new Set();
  for (const r of SH[cc].recs) if (r.n3) { n1.add(r.n1); n2.add(r.n2); }
  if (n2.size > 1 && n2.size <= 30) return 'n2';
  if (n1.size > 1) return 'n1';
  if (n2.size > 1) return 'n2';
  return 'none';
}
const nutsName = (cc, code) => (SH[cc].sh.nuts || {})[code] || code;
const regionOf = (r) => { if (r.country === 'CH') return { code: r.canton, name: r.cantonName }; const l = regionLevel(r.country); if (l === 'none') return null; const code = l === 'n1' ? r.n1 : r.n2; return code ? { code, name: nutsName(r.country, code) } : null; };
const localOf = (r) => r.country === 'CH' ? r.cantonName : nutsName(r.country, r.n3);
const cslug = (cc) => slugify(countries.find((c) => c.cc === cc).name);
const rslugCache = {};
function rslug(cc, reg) { const k = cc + ':' + reg.code; if (!rslugCache[k]) { const s = slugify(reg.name); rslugCache[k] = s && s.length > 1 ? s : reg.code.toLowerCase(); } return rslugCache[k]; }

// rankings: country-wide and per region, every profile
const FAST = !!process.env.NZ_FAST;
// 2.15.13: the complete SEO expansion runs whenever build/seo.enabled is committed, so the existing GitHub workflow
// (which a codespace cannot change) builds it too. NZ_FULL_SEO=0 forces a quick build without it.
const FULLSEO = process.env.NZ_FULL_SEO === '1' || (process.env.NZ_FULL_SEO !== '0' && fs.existsSync(path.join(ROOT, 'build/seo.enabled')));
if (FAST && FULLSEO) throw new Error('NZ_FAST is not a complete SEO build');
console.time('rank');
const RANK = {};      // RANK[cc][profile] = {byId:{id:{rank,score}}, n, list}
const RRANK = {};     // RRANK[cc][regionCode][profile]
for (const c of (FAST ? [] : countries)) {
  const recs = SH[c.cc].recs;
  RANK[c.cc] = {}; RRANK[c.cc] = {};
  for (const p of profiles) {
    const res = engine.rank(recs, p, { country: c.cc, subRanks: false });
    const byId = {}; res.scored.forEach((x) => { byId[x.id] = { rank: x.rank, score: x.overall }; });
    RANK[c.cc][p] = { byId, n: res.scored.length, list: res.scored.slice(0, 40), reasons: res.reasons };
  }
  const regs = {};
  for (const r of recs) { const g = regionOf(r); if (g) (regs[g.code] ||= { reg: g, recs: [] }).recs.push(r); }
  for (const [code, o] of Object.entries(regs)) {
    RRANK[c.cc][code] = { reg: o.reg, recs: o.recs, p: {} };
    for (const p of profiles) {
      const res = engine.rank(o.recs, p, { country: c.cc, subRanks: false });
      const byId = {}; res.scored.forEach((x) => { byId[x.id] = { rank: x.rank, score: x.overall }; });
      RRANK[c.cc][code].p[p] = { byId, n: res.scored.length, list: res.scored.slice(0, 15) };
    }
  }
}
console.timeEnd('rank');

// ------------------------------------------------------------------ page registry (paths)
const PAGES = {};      // record id -> path
const pageRecs = [];
for (const c of (FAST ? [] : countries)) {
  const used = {};
  const list = SH[c.cc].recs.filter((r) => c.cc === 'CH' || r.population >= 30000);
  for (const r of list) {
    const g = regionOf(r);
    const base = `/${cslug(c.cc)}/${g ? rslug(c.cc, g) + '/' : ''}`;
    let s = slugify(stripParen(r.name)) || slugify(r.name) || r.oid.toLowerCase();
    if (used[base + s]) s = s + '-' + slugify(r.oid);
    used[base + s] = 1;
    PAGES[r.id] = base + s + '/';
    pageRecs.push(r);
  }
}
// Stable URLs for the complete, compact SEO postprocessor.
if (FULLSEO) {
  const legacy = JSON.parse(zlib.gunzipSync(fs.readFileSync(path.join(ROOT, 'build/seo-legacy-paths.json.gz'))).toString('utf8')).paths;
  for (const c of countries) for (const r of SH[c.cc].recs) if (!r.superseded) {
    PAGES[r.id] = legacy[r.id] || '/places/' + c.cc.toLowerCase() + '/' + encodeURIComponent(String(r.oid)) + '/';
  }
}
const regionPath = (cc, reg) => `/${cslug(cc)}/${rslug(cc, reg)}/`;
const countryPath = (cc) => `/${cslug(cc)}/`;
const profilePath = (p) => `/best/${PSLUG[p]}/`;
const appLink = (o) => '/#/explore?' + new URLSearchParams(o).toString();

// ------------------------------------------------------------------ bundles
async function bundle() {
  const css = (await esbuild.transform(read('src/css/base.css') + read('src/css/app.css') + read('src/css/v3.css'), { loader: 'css', minify: true })).code;
  const siteCss = (await esbuild.transform(read('src/css/base.css') + read('src/css/lists.css'), { loader: 'css', minify: true })).code;
  const parts = ['src/engine.js', 'src/data.js', ...fs.readdirSync(path.join(ROOT, 'src/js')).sort().filter((f) => f !== '57-local.js').map((f) => 'src/js/' + f)];   /* 57-local (amenities, regional snapshot) ships in the on-demand module */
  const EMOJI = JSON.parse(fs.readFileSync(path.join(ROOT, 'build/icons/emoji_icons.json'), 'utf8'));
  fs.writeFileSync(path.join(ROOT, 'data/icons.json'), JSON.stringify(Object.fromEntries(Object.entries(EMOJI.map).map(([e, n]) => [e, EMOJI.icons[n]]))));   /* line icons that replace emoji in the app (loaded on first use) */
  const app = ('var PICON = ' + JSON.stringify(Object.fromEntries(Object.entries(PICON).filter(([k]) => !/^(cat|ui)_/.test(k) && !(cfg.bizDormant || []).includes(k) && !/^biz_/.test(k)))) + ';\n')   /* 2.14: business icons load with the on-demand module (start page budget) */  /* cat_/ui_ icons are only used in the built HTML */ + parts.map((p) => p === 'src/engine.js' ? read(p).replace(/(var METHOD_V2 = \[\s*'(?:[^'\\]|\\.)*',)[\s\S]*?\n  \];/, '$1\n  ];')   /* the browser shows only the first method note; the full list builds the Method page */ : read(p)).join('\n;\n').replace(/__VERSION__/g, VERSION).replace('__EMO__', JSON.stringify(Object.keys(EMOJI.map).join('|')));
  const min = process.env.NZ_DEBUG ? { code: '(function(){' + app + '\n})();' } : await terser.minify('(function(){' + app + '\n})();', { ecma: 2020, compress: { passes: 2, arrows: true, unsafe_arrows: true }, mangle: true, format: { comments: false } });
  if (min.error) throw min.error;
  // the on-demand part (All data, compare all rows, data catalogue): names resolve through the app's bridge (NZI)
  const moreSrc = 'window.NZX=function(I){with(I){Object.assign(PICON,' + JSON.stringify(Object.fromEntries(Object.keys(PICON).filter((k) => /^biz_/.test(k) || (cfg.bizDormant || []).includes(k)).map((k) => [k, PICON[k]]))) + ');var CATALOGUE=' + JSON.stringify(CATALOGUE) + ', WHO_MORE=' + JSON.stringify(WHO_MORE()) + ';\n' + (read('src/js/57-local.js') + '\n' + read('src/more/econ_tables.js') + '\n' + read('src/more/more.js') + '\n' + read('src/more/builder.js') + '\n' + read('src/more/game.js') + '\n' + read('src/more/tour.js') + '\n' + read('src/more/records.js') + '\n' + read('src/more/personal.js') + '\n' + read('src/more/compare.js') + '\n' + read('src/more/booklet.js') + '\n' + read('src/more/lazy_views.js')).replace(/__VERSION__/g, VERSION) + '\nreturn {toolsHTML:toolsHTML,allDataHTML:allDataHTML,adHydrate:adHydrate,adCSV:adCSV,cmpAllHTML:cmpAllHTML,cmpAllHydrate:cmpAllHydrate,openCatalogue:openCatalogue,photoMetaOk:photoMetaOk,photoPixelFilter:photoPixelFilter,photoFromInfo:photoFromInfo,photoStem:photoStem,PHOTO_PEOPLE:PHOTO_PEOPLE,REG_MORE:REG_MORE,whoMoreFill:whoMoreFill,AMEN_MORE:AMEN_MORE,adAll:adAll,photosWith:photosWith,docAllHTML:docAllHTML,docLive:docLive,compareDoc:compareDoc,printInto:printInto,click:click,whoMore:whoMore,openBuilder:openBuilder,builderClick:builderClick,builderInput:builderInput,gameRound:gameRound,gameGuess:gameGuess,startTour:startTour,tourNext:tourNext,recordsHTML:recordsHTML,scorecardHTML:scorecardHTML,openTop10:openTop10,openWhatIf:openWhatIf,openBetterThanHome:openBetterThanHome,openMyData:openMyData,ptInput:ptInput,openCompare:openCompare,openBooklet:openBooklet,keyFactsHTML:keyFactsHTML,evidenceCSV:evidenceCSV,globalRankHTML:globalRankHTML,GRANK_TEXT:GRANK_TEXT,didYouMean:didYouMean,catClick:catClick,boardHTML:boardHTML,radarSVG:radarSVG,postcardSVG:postcardSVG,catDetailHTML:catDetailHTML,anchorPins:anchorPins,amenitiesFor:amenitiesFor,amenitiesHTML:amenitiesHTML,facilitiesHTML:facilitiesHTML,programmesHTML:programmesHTML,zonesMap:zonesMap,scoreContext:scoreContext,regionStatsFor:regionStatsFor,regionStatsHTML:regionStatsHTML,ready:CTX_READY};}};';
  const more = process.env.NZ_DEBUG ? { code: moreSrc } : await terser.minify(moreSrc, { compress: { passes: 2 }, mangle: true, format: { comments: false } });
  if (more.error) throw more.error;
  fs.writeFileSync(path.join(ROOT, 'assets/more.js'), more.code);
  // the start page globe, loaded once the page is idle
  const globeSrc = read('src/globe/globe.js');
  const globe = process.env.NZ_DEBUG ? { code: globeSrc } : await terser.minify(globeSrc, { compress: { passes: 2 }, mangle: true, format: { comments: false } });
  if (globe.error) throw globe.error;
  fs.writeFileSync(path.join(ROOT, 'assets/globe.js'), globe.code);
  // 2.13.3 feedback layer (motion, optional sounds, vibration on phones), loaded when the page is idle
  const fxSrc = read('src/fx/fx.js');
  const fx = process.env.NZ_DEBUG ? { code: fxSrc } : await terser.minify(fxSrc, { compress: { passes: 2 }, mangle: true, format: { comments: false } });
  if (fx.error) throw fx.error;
  fs.writeFileSync(path.join(ROOT, 'assets/fx.js'), fx.code);
  const home = await terser.minify(read('src/fx/home.js'), { compress: { passes: 2 }, mangle: true, format: { comments: false } }); if (home.error) throw home.error;
  fs.writeFileSync(path.join(ROOT, 'assets/home.js'), home.code);
  // 2.14 (owner audit A1): the comparison upgrade, bundled from the supplied utilities (src/upgrade/vendor, unchanged)
  // and loaded on the first comparison; its own file, so neither the start page nor the app script grows
  const nzx = esbuild.buildSync({ entryPoints: [path.join(ROOT, 'src/upgrade/compare_upgrade.mjs')], bundle: true, format: 'iife', minify: !process.env.NZ_DEBUG, target: 'es2019', write: false, legalComments: 'none' });
  fs.writeFileSync(path.join(ROOT, 'assets/nzx.js'), nzx.outputFiles[0].text);
  // the business globe (hexagons and radar) for the start page's Business mode, loaded only when that mode is chosen
  const bg = await terser.minify(read('src/business/globe.js'), { compress: { passes: 2 }, mangle: true, format: { comments: false } });
  if (bg.error) throw bg.error;
  fs.writeFileSync(path.join(ROOT, 'assets/bizglobe.js'), 'window.NZB_HEX=' + read('build/source/business/globe_hex.json').trim() + ';\n' + bg.code);
  return { css, siteCss, js: min.code };
}

