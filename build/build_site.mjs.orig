</div></section>
<section class="band home-only"><h2>From “where?” to a shortlist in three moves</h2><ol class="steps"><li>${ico('ui_users', 26)}<h3>Say who is moving</h3><p>Pick one of ${profiles.length} profiles or answer a few questions to build your own. The weights stay visible, so you always know why a place ranks.</p></li><li>${ico('ui_map', 26)}<h3>Choose where to look</h3><p>A whole country, a region or a single canton or département. Narrow it by size, airport, big-city or sea distance.</p></li><li>${ico('ui_scale', 26)}<h3>Compare and decide</h3><p>Every place gets a scorecard, trends, close alternatives and local context. Save favourites, compare side by side and print a booklet for the visit.</p></li></ol></section>
<section class="band feature home-only" id="feat"><div class="feature-copy"><h2 id="feat-h">Switzerland, down to the last commune</h2><p class="lede" id="feat-l">2,172 municipalities, with about 28 local measures each. This is the young family fit, right now:</p><ol class="rank-list" id="feat-ol">${CH.map((x) => `<li><span class="n">${x.rank}</span><span><a href="${PAGES[x.r.id] || '#'}">${esc(x.r.name)}</a><br><span class="small muted">${esc(x.r.cantonName)}, ${fmtInt(x.r.popNow)} residents</span></span><span class="chip tone-good"><b>${fmt(x.overall)}</b></span></li>`).join('')}</ol><a class="btn btn-primary" id="feat-a" href="/#/explore?cc=CH&p=young_family">Open Switzerland</a></div><figure class="feature-map" id="feat-fig"><img src="/assets/hero-ch.svg?v=${VERSION}" alt="Swiss municipalities coloured by fit for young families" width="1000" height="652" loading="lazy" decoding="async"><figcaption>Young family fit, municipality by municipality</figcaption></figure></section>
<section class="band home-only" id="profiles"><h2>A profile for every kind of move</h2><p class="small muted" style="margin-top:-6px">For households. Company sites and small businesses have <a href="#business-sites">their own profiles</a>.</p><p class="lede">Each profile is a transparent set of weights. Open one to see its best places across all ${countries.length} countries.</p><div class="tiles">${profiles.map((k) => `<a class="tile" href="${profilePath(k)}" style="--tone:${cfg.tones[k] || '#0e7490'}"><span class="ico">${`<i data-pico="${k}"></i>`}</span><span><b>${esc(engine.profiles[k].name)}</b><small>${esc(TILE_BLURB[k] || (engine.profiles[k].intro || '').split('.')[0])}</small></span></a>`).join('')}</div></section>

<section class="band home-only" id="rankings"><h2>World and continental rankings</h2><p class="lede">Places compared across borders: national standing, comparable measures and rank in the country.</p>${rankTiles('young_family', 'towns and cities')}</section>
<div id="biz-extra" class="biz-only" hidden></div>
<section class="band" id="countries"><h2>${countries.length} countries, honest about depth</h2><p class="lede"><span class="depth detailed"></span>Local official data (${countries.filter((c) => DEPTH_CLS(c) === 'detailed').length}) <span class="depth partial" style="margin-left:12px"></span>Regional official data (${countries.filter((c) => DEPTH_CLS(c) === 'partial').length}) <span class="depth foundation" style="margin-left:12px"></span>Regional overview (${countries.filter((c) => DEPTH_CLS(c) === 'foundation').length}). Each country page lists what is measured there.</p><div class="tiles" id="country-tiles"><p class="ctry-links">${countries.map((c) => `<a href="${countryPath(c.cc)}">${esc(c.name)}</a>`).join(' ')}</p></div></section>
<section class="band"><div class="card ad-card"><div style="max-width:62ch"><h2 style="font-size:var(--step-1)">Partner placement <span class="chip" style="margin-left:6px">Advertising</span></h2><p class="small" style="margin:6px 0 0">Paid messages are clearly labelled and stay separate from rankings, scores and editorial place context. <a href="/legal/#advertising">Advertising policy</a></p></div><a class="btn" href="mailto:torsten.sauter@icloud.com?subject=Nestlyzer%20advertising%20inquiry">Contact for sponsorship</a></div></section>
<section class="band faq home-only"><h2>Questions people ask</h2>${faq.map(([q, a]) => `<details><summary>${esc(q)}</summary><p>${esc(a)}</p></details>`).join('')}</section><div style="height:72px"></div>`;
  const ld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Nestlyzer', url: SITE + '/', description: 'Find the best place to live for your household, in Europe, North America, Asia and Oceania.', potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: SITE + '/?q={search_term_string}' }, 'query-input': 'required name=search_term_string' } },
    { '@context': 'https://schema.org', '@type': 'Organization', name: 'Nestlyzer', url: SITE + '/', logo: SITE + '/assets/icon-512.png', email: 'torsten.sauter@icloud.com' }];   // 2.13.1: FAQPage markup dropped on the start page (Google shows FAQ results only for government and health sites); the questions stay on the page
  return { html, ld };
}

// ------------------------------------------------------------------ hero point cloud (landing)
function heroBin() {
  const pts = [];
  for (const c of countries) for (const r of SH[c.cc].recs) if (Number.isFinite(r.lat) && Number.isFinite(r.lon) && !r.whole) pts.push(r);
  pts.sort((a, b) => a.population - b.population);
  const P = HERO_PROFILES.length, NB = Math.ceil(P / 2), n = pts.length, buf = Buffer.alloc(4 + n * (2 + 2 + 1 + NB));
  buf.writeUInt32LE(n, 0);
  let o = 4;
  for (const r of pts) { buf.writeUInt16LE(Math.round((r.lon + 180) / 360 * 65535), o); o += 2; }
  for (const r of pts) { buf.writeUInt16LE(Math.round((r.lat + 90) / 180 * 65535), o); o += 2; }
  for (const r of pts) { buf.writeUInt8(Math.max(0, Math.min(255, Math.round(Math.log10(Math.max(r.population, 10)) * 40))), o); o += 1; }
  // bands are relative within each country, so every country shows its own best places as brightly
  const band = HERO_PROFILES.map(() => new Map());
  HERO_PROFILES.forEach((p, pi) => {
    const byC = {};
    for (const r of pts) { const sr = engine.scoreRaw(r, p, 55, r.country); if (!sr || engine.eligibilityFail(r, p, r.country)) { band[pi].set(r, 1); continue; } (byC[r.country] = byC[r.country] || []).push([r, sr.score]); }
    for (const cc in byC) { const a = byC[cc].sort((x, y) => x[1] - y[1]); a.forEach(([r], i) => band[pi].set(r, Math.max(2, Math.min(15, 2 + Math.floor(13 * (i + 0.5) / a.length))))); }
  });
  for (const r of pts) {
    for (let k = 0; k < P; k += 2) { buf.writeUInt8((band[k].get(r) << 4) | (k + 1 < P ? band[k + 1].get(r) : 0), o); o += 1; }
  }
  fs.writeFileSync(path.join(ROOT, 'data/hero.bin'), buf);
  write('data/hero.json', JSON.stringify({ v: VERSION, profiles: HERO_PROFILES, n, bytes: NB, frame: { lon: [-180, 180], lat: [-90, 90] }, layout: 'u32 n | u16 lon[n] | u16 lat[n] | u8 log10(pop)*40 [n] | u8 two 4-bit scores [n*bytes] in profile order; 0 = no value, 1..15 = score bands' }));
  return n;
}


// ------------------------------------------------------------------ Business locations · Beta (separate static page)
/* The supplied Business Beta (build/source/business/, 16 Oct 2026) restyled in a Nestlyzer Business variant: the same
   fonts, logo, header and paper as the residential site, with a teal and copper accent instead of blue and sun yellow.
   Its code and data are kept as supplied; only the theme, the header and the honest counts change: the UK and Sweden
   raw overlays it describes are not part of this build, so their counts are shown as 0. */
function businessPage() {
  const srcP = 'build/source/business/Nestlyzer_Business_Beta_2026-10-16.html';
  let h = read(srcP);
  /* 2.9 repairs to the supplied beta, each asserted so a changed source fails loudly (re-audit 18 Oct 2026):
     NZ-GLOBAL-051 a blank or invalid quantity is unknown or invalid, never zero; NZ-GLOBAL-052 the screen and the brief
     share one annual consumption and the brief records the screen it was made from. */
  const bizPatch = (from, to) => { if (h.split(from).length !== 2) throw new Error('business page patch target not found once: ' + from.slice(0, 60)); h = h.replace(from, to); };
  bizPatch("function num(id,defaultValue=0){const v=Number($(id).value);return Number.isFinite(v)?Math.max(0,v):defaultValue;}",
    "function qty(id){const el=$(id),s=String(el.value).trim();if(s==='')return{v:null,status:'unknown'};const v=Number(s);if(!Number.isFinite(v)||v<0||(el.max!==''&&v>Number(el.max)))return{v:null,status:'invalid'};return{v:v,status:'known'};}" +
    "function num(id,defaultValue=0){const q=qty(id);return q.status==='known'?q.v:defaultValue;}function qv(id){return qty(id).v;}");
  bizPatch("k=$('industry').value,kwh=Math.min(num('energy-kwh'),1e12);", "k=$('industry').value,kq=qty('energy-kwh'),kwh=kq.v;");
  bizPatch("['Illustrative annual electricity, USD',s=>fmt(energy(s,kwh),0)]", "['Illustrative annual electricity, USD',s=>kwh==null?(kq.status==='invalid'?'Check the consumption figure':'Enter annual consumption'):fmt(energy(s,kwh),0)]");
  bizPatch("planned_headcount:num('brief-headcount'),premises_m2:num('brief-area'),peak_power_mw:num('brief-power'),annual_electricity_kwh:num('brief-kwh'),",
    "planned_headcount:qv('brief-headcount'),premises_m2:qv('brief-area'),peak_power_mw:qv('brief-power'),annual_electricity_kwh:qv('brief-kwh')," +
    "quantity_status:{planned_headcount:qty('brief-headcount').status,premises_m2:qty('brief-area').status,peak_power_mw:qty('brief-power').status,annual_electricity_kwh:qty('brief-kwh').status}," +
    "screening:{industry:$('industry').value,min_industry_jobs:qv('min-jobs'),max_industrial_price_us_cents_kwh:qv('max-price'),weights:{employment_scale:+$('w-scale').value,location_quotient:+$('w-lq').value,electricity_price:+$('w-price').value},compared_states:[$('state-a').value,$('state-b').value],top_states:stateRank().slice(0,5).map(s=>s.code)},");
  bizPatch("{schema:'nestlyzer-company-brief-v1',", "{schema:'nestlyzer-company-brief-v2',");
  bizPatch("annual_electricity_kwh:'brief-kwh',notes:'brief-notes'}))if(b[key]!=null)$(id).value=b[key];",
    "annual_electricity_kwh:'brief-kwh',notes:'brief-notes'}))if(b[key]!=null)$(id).value=b[key];else if(key in b&&b.schema==='nestlyzer-company-brief-v2')$(id).value='';if($('brief-kwh').value!==$('energy-kwh').value){$('energy-kwh').value=$('brief-kwh').value;}");
  bizPatch("['industry','min-jobs','max-price','energy-kwh','w-scale','w-lq','w-price'].forEach(id=>$(id).addEventListener('input',renderStates));",
    "['industry','min-jobs','max-price','energy-kwh','w-scale','w-lq','w-price'].forEach(id=>$(id).addEventListener('input',renderStates));" +
    "$('energy-kwh').addEventListener('input',()=>{$('brief-kwh').value=$('energy-kwh').value;});$('brief-kwh').addEventListener('input',()=>{$('energy-kwh').value=$('brief-kwh').value;renderStates();});");
  h = h.replace(/(<script type="application\/json" id="business-data">)([\s\S]*?)(<\/script>)/, (m, a, json, c) => {
    const d = JSON.parse(json);
    d.counts.native_overlay_values = 0; d.counts.native_overlay_places = 0; d.counts.overlay_by_country = {};
    (d.coverage || []).forEach((x) => { x.raw_overlay_values = 0; x.raw_overlay_places = 0; });
    d.integration_note = 'UK and Sweden raw overlays from the 16 Oct 2026 package are not part of this website build.';
    return a + JSON.stringify(d).replace(/</g, '\\u003c') + c;
  });
  const font = (f) => `data:font/woff2;base64,${fs.readFileSync(path.join(ROOT, 'assets/fonts', f)).toString('base64')}`;
  const theme = `<style id="nz-business-theme">
@font-face{font-family:"Bricolage";font-weight:200 800;font-stretch:75% 100%;font-display:swap;src:url(${font('bricolage-grotesque-latin-standard-normal.woff2')}) format("woff2")}
@font-face{font-family:"Public Sans";font-weight:100 900;font-display:swap;src:url(${font('public-sans-latin-wght-normal.woff2')}) format("woff2")}
:root{--ink:#132238;--muted:#4f5d6e;--line:#dfe3e8;--paper:#f6f4ef;--navy:#0B2E5C;--teal:#EA580C;--soft:#fff1e8;--warm:#fde7d6;--copper:#F97316}
body{font-family:"Public Sans",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--paper)}
h1,h2,h3,.stat b,.brand{font-family:"Bricolage","Public Sans",ui-sans-serif,system-ui,sans-serif}
h1{font-stretch:85%;letter-spacing:-.01em}
header{background:linear-gradient(90deg,#08223f 0%,#0B2E5C 55%,#0d3f55 100%);border-bottom:3px solid var(--teal)}
.nzb-brand{display:flex;align-items:center;gap:10px;color:#fff;text-decoration:none}.nzb-brand b{font:700 25px "Bricolage",sans-serif;font-stretch:85%}
.nzb-brand span{font:500 18px "Public Sans",sans-serif;color:#FDBA74}.nzb-brand small{font:700 12px "Public Sans",sans-serif;background:var(--copper);color:#fff;padding:3px 8px;border-radius:999px}
.mark .mk-pin{fill:var(--teal)}
nav button[aria-selected=true]{background:var(--teal);border-color:var(--teal)}
.pill.warn{background:var(--warm);color:#7a3f0c}.barfill{background:linear-gradient(90deg,var(--teal),#FB923C)}
a{color:#0B2E5C}button:focus-visible,a:focus-visible,input:focus,select:focus{outline-color:var(--copper)}
.card,.stat{border-radius:14px}
</style>`;
  const mark = MARK_INLINE.replace('fill="#F5B700"', 'fill="#F97316"');
  h = h.replace(/<meta name="robots" content="noindex">/g, '');   // 2.15.14: /business/ is a full public page and listed in the sitemap: it must be indexable (Search Console noindex warning)
  h = h.replace('</head>', theme + '</head>')
    .replace(/<div class="brand">Nestlyzer <span style="font-weight:400">Business<\/span><small>Beta<\/small><\/div>/, `<a class="nzb-brand" href="/" aria-label="Nestlyzer home">${mark}<b>Nestlyzer</b><span>Business</span></a>`)
    .replace('<a id="back-home" href="../index.html">Residential Nestlyzer</a>', '<a id="back-home" href="/">Places to live</a>')
    .replace(/<title>[^<]*Beta<\/title>/, '<title>Nestlyzer Business: country data, taxes and site screening</title>');   // 2.12: no beta labels (owner request 31 Oct)
  // the Business globe: hexagon land cells, a radar sweep, the two compared economies lit (src/business/globe.js)
  const hex = read('build/source/business/globe_hex.json');
  const gjs = read('src/business/globe.js');
  const introEnd = h.indexOf('</section>', h.indexOf('<section class="intro">'));
  if (introEnd < 0) throw new Error('business page: intro section not found');
  h = h.slice(0, introEnd) + '<div class="nzb-globe"><canvas id="nzb-globe" role="img" aria-label="Globe: land as hexagons; economies with data are brighter; the two compared economies are highlighted"></canvas><p class="nzb-key"><span><i class="ka"></i>Economy A</span> <span><i class="kb"></i>Economy B</span> <span><i class="kd"></i>Places ranked</span></p></div>' + h.slice(introEnd);
  const cta = '<p class="nzb-cta"><a class="button" id="nzb-rank" href="/#/explore?cc=CH&amp;p=biz_manufacturing">Rank municipalities for a business site</a> <span class="small muted">Manufacturing, logistics, tech, labs, offices and HQ, with must-haves</span></p>';
  const ctaJs = "(function(){var a=document.getElementById('nzb-rank'),s=document.getElementById('country-a'),ok=" + JSON.stringify(countries.map((c) => c.cc)) + ",map={GB:'UK',GR:'EL'};function u(){var c=map[s.value]||s.value;if(ok.indexOf(c)<0)c='CH';a.href='/#/explore?cc='+c+'&p=biz_manufacturing';}if(a&&s){s.addEventListener('change',u);u();}})();";
  // 2.15.12: twin of the household profiles page — the company profiles as icon tiles with their worldwide top three (flags)
  const bizTiles = `<section class="nzb-prof" aria-labelledby="nzb-prof-h"><h2 id="nzb-prof-h">Best places for your business site</h2><p class="nzb-lede">${BIZ.length} company profiles, each a transparent set of weights and must-haves. Pick the kind of site to see its best municipalities in ${countries.length} countries.</p>${(cfg.bizGroups || [['Business locations', BIZ]]).map(([g, ks]) => { const K = ks.filter((k) => BIZ.includes(k)); return K.length ? `<h3>${esc(g)}</h3><div class="nzb-tiles">${K.map((k) => `<a class="nzb-tile" href="${bizPath(k)}"><span class="ico">${ico(k, 20)}</span><span><b>${esc(engine.profiles[k].name)}</b><small>${esc((engine.profiles[k].intro || '').split('.')[0])}</small>${worldTop(k)}</span></a>`).join('')}</div>` : ''; }).join('')}</section>`;
  const bizTileCss = '<style>.nzb-prof{margin:18px 0 26px}.nzb-prof h2{font-size:clamp(1.5rem,4vw,2.2rem);margin:0 0 6px}.nzb-lede{color:var(--muted);max-width:62ch;margin:0 0 10px}.nzb-prof h3{font-size:1rem;margin:16px 0 8px;color:var(--muted)}.nzb-tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,250px),1fr));gap:10px}.nzb-tile{display:flex;gap:12px;align-items:flex-start;border:1px solid var(--line);border-radius:14px;padding:14px;background:#fff;color:var(--ink);text-decoration:none;transition:border-color .15s}.nzb-tile:hover{border-color:#EA580C}.nzb-tile .ico{display:grid;place-items:center;width:38px;height:38px;flex:none;border-radius:12px;background:#fff1e8;color:#EA580C}.nzb-tile .ico svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.nzb-cta .button,#nzb-rank{background:#EA580C!important;border-color:#EA580C!important;color:#fff!important}.nzb-tile b{display:block}.nzb-tile small{display:block;color:var(--muted);font-size:13px;margin-top:2px}.wtop{display:grid;gap:1px;margin-top:6px;font-size:12px;color:var(--muted)}.wtop span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.wtop .flag{vertical-align:-1px}</style>';
  h = h.replace('</head>', bizTileCss + '</head>');
  h = h.replace('<div class="nzb-globe">', cta + bizTiles + '<div class="nzb-globe">');
  h = h.replace('</body>', '<script>window.NZB_HEX=' + hex + ';</script><script>' + gjs + '</script><script>' + ctaJs + '</script></body>');
  h = h.replace('</style>\n</head>', '</style></head>').replace('<style id="nz-business-theme">', '<style id="nz-business-theme">.intro{grid-template-columns:1fr minmax(220px,300px)!important;align-items:start;grid-template-rows:auto auto auto 1fr;row-gap:14px}.intro>div:first-child{grid-column:1}.nzb-cta{grid-column:1;margin:4px 0 0}.nzb-cta .button{background:#0F7C7A;color:#fff;border-color:#0F7C7A;font-weight:700}.intro>.pill{grid-column:1;justify-self:start}.nzb-globe{grid-column:2;grid-row:1 / span 4;align-self:start}.nzb-globe canvas{display:block;width:100%;aspect-ratio:1}.nzb-key{margin:6px 0 0;font-size:12px;color:var(--muted);text-align:center}.nzb-key span{white-space:nowrap}.nzb-key i{display:inline-block;width:10px;height:10px;border-radius:2px;margin:0 4px 0 10px;vertical-align:-1px}.nzb-key .ka{background:#e08b3c}.nzb-key .kb{background:#5fd0c4}.nzb-key .kd{background:rgba(95,208,196,.55)}@media (max-width:760px){.intro{grid-template-columns:1fr!important}.nzb-globe{grid-column:1;grid-row:auto;max-width:260px;margin:0 auto;order:-1}}\n');
  if (!h.includes('nz-business-theme') || !h.includes('nzb-brand')) throw new Error('business page: theme or header not applied');
  if (!/rel="canonical"/.test(h)) h = h.replace('</head>', `<link rel="canonical" href="${SITE}/business/"></head>`);   // 2.12.4: self-referencing canonical
  // 2.13.3: the advice notice on the country business data page too (taxes, incentives and costs are shown here)
  h = h.replace('<section class="intro">', SITE_NOTE.replace('<p class="nz-note"', '<p class="nz-note" style="font-size:12.5px;line-height:1.45;background:rgba(232,155,22,.1);border:1px solid rgba(232,155,22,.35);border-radius:10px;padding:7px 10px;margin:8px auto;max-width:1120px"') + '<section class="intro">');
  if (!h.includes('General location information, no individual advice')) throw new Error('business page: advice notice not placed');
  write('business/index.html', h); SITEMAP.push('/business/');
}

// ------------------------------------------------------------------ run
const t0 = Date.now();
const B = await bundle();
const hero = heroSvg();
console.time('heroBin'); const heroN = heroBin(); console.timeEnd('heroBin');
const L = landing();
let shell = read('src/shell.html');
shell = shell.replace('__CSS__', () => B.css).replace('__JS__', () => B.js).replace('__LANDING__', () => L.html).replace('__HEADER__', () => header(true)).replace('__FOOTER__', () => footer()).replace('__TRACKING__', () => tracking()).replace('__CONSENT_HTML__', () => CONSENT_HTML).replace('__CONSENT_JS__', () => '<script>' + CONSENT_SRC + '</script>')
  .replace('__JSONLD__', () => JSON.stringify(L.ld).replace(/</g, '\\u003c')).replace(/__VERSION__/g, VERSION).replace(/__TOTAL__/g, TOTAL).replace(/__COUNTRIES__/g, countries.length)
  .replace('__FIT__', ICON.fit).replace('__MAP__', ICON.map).replace('__LIST__', ICON.list).replace('__PIN__', ICON.pin).replace(/__SPARK__/g, ICON.spark).replace(/__SLIDERS__/g, ICON_X.sliders).replace(/__HEART__/g, ICON_X.heart).replace(/__CLOSE__/g, ICON_X.close);
write('index.html', emojiSvg(shell, true));
write('data/start_biz.html', emojiSvg(BIZ_EXTRA()));
// 2.15: the country tiles load after first paint (start page budget), and the feature band follows the selected country
write('data/start_countries.html', countries.map((c) => `<a class="tile" href="${countryPath(c.cc)}"><span class="ico flagico">${flagImg(c.cc, 20)}</span><span><b><span class="depth ${DEPTH_CLS(c)}"></span>${esc(c.name)}</b><small>${units(c.cc, c.n).replace(/ (municipalities|places)$/, ' places')}</small></span></a>`).join(''));
if (!FAST) for (const c of countries) {
  const recs = SH[c.cc].recs, fc = recs.map((r) => r.availableFactorCount || 0).sort((a, b) => a - b), top = {};
  for (const p of profiles) { const R = RANK[c.cc][p]; if (R) top[p] = R.list.slice(0, 5).map((x) => [x.r.id, x.r.name, localOf(x.r) || '', x.r.popNow || x.r.population || 0, Math.round(x.overall * 10) / 10, PAGES[x.r.id] || '']); }
  write(`data/feature/${c.cc}.json`, JSON.stringify({ ins: { FR: ['france-rent-vs-income', 'Rent against income in 31,000 French towns'], CH: ['switzerland-income-tax-by-commune', 'Swiss income tax, commune by commune'], DE: ['germany-rents-and-property-tax', 'German rents and property tax'], IT: ['italy-rental-yields', 'Italian rental yields'], ES: ['spain-income-and-inequality', 'Spanish income and inequality'], SE: ['sweden-tax-and-income', 'Swedish tax and income'], UK: ['uk-house-prices-vs-pay', 'UK house prices against pay'], US: ['us-income-and-life-expectancy', 'US income and life expectancy'] }[c.cc] || null, cc: c.cc, name: c.name, units: units(c.cc, c.n), unit1: unitW(c.cc, 1), nf: fc[fc.length >> 1] || 0, top }));
}
write('assets/site.css', B.siteCss);
// clean previously generated page folders
if (!FAST) {
const GEN_ROOTS = new Set([...countries.map((c) => cslug(c.cc)), 'best', 'method', 'legal', 'incentives', 'districts', 'immigration']);
for (const d of GEN_ROOTS) fs.rmSync(path.join(ROOT, d), { recursive: true, force: true });
SITEMAP.length = 0; SITEMAP.push('/');
methodPage(); legalPage(); aboutPage();
businessPage();
{ const seen = new Map(); for (const r of pageRecs) { const k = r.country + '|' + r.name; seen.set(k, (seen.get(k) || 0) + 1); } for (const [k, n] of seen) if (n > 1) DUPNAME.add(k); }
bestIndexPage();
for (const p of profiles) profilePage(p);
if (!FAST) { for (const d of fs.readdirSync(path.join(ROOT, 'business'), { withFileTypes: true })) if (d.isDirectory()) fs.rmSync(path.join(ROOT, 'business', d.name), { recursive: true, force: true }); for (const p of BIZ) bizPage(p); }
for (const c of countries) { countryPage(c); for (const code of Object.keys(RRANK[c.cc])) regionPage(c.cc, code); for (const m of metrosOf(c.cc)) metroPage(c.cc, m); }
if (!FULLSEO) for (const r of pageRecs) placePage(r);
write('data/pages.json', JSON.stringify(PAGES));
// static page → app view, used by the single-file offline copy so its links stay inside the app
const ROUTES = {};
for (const c of countries) {
  ROUTES[countryPath(c.cc)] = appLink({ cc: c.cc, p: 'young_family' });
  for (const code of Object.keys(RRANK[c.cc])) ROUTES[regionPath(c.cc, RRANK[c.cc][code].reg)] = appLink({ cc: c.cc, p: 'young_family', ...(c.cc === 'CH' ? { a: code } : { r: code }) });
  for (const m of metrosOf(c.cc)) ROUTES[metroPath(c.cc, m.name)] = appLink({ cc: c.cc, p: 'young_family', r: 'M:' + m.name });
}
for (const p of profiles) ROUTES[profilePath(p)] = appLink({ cc: 'CH', p });
ROUTES['/best/'] = appLink({ cc: 'CH', p: 'young_family' });
for (const [id, pth] of Object.entries(PAGES)) ROUTES[pth] = appLink({ cc: id.split(':')[0], p: 'young_family', sel: id });
write('data/routes.json', JSON.stringify(ROUTES));
}
// 2.13: Insights, business-location analyses with charts
const INSIGHTS_N = buildInsights({ ROOT, page, esc, fmt, fmtInt, countries, flagImg, appLink, cslug, bizPath, profilePath, PAGES, SITE });
console.log('insights pages', INSIGHTS_N.n);
// 404, sitemap(s), robots, manifest
write('ads.txt', ADS_TXT);
write('assets/consent.js', CONSENT_SRC);
write('404.html', `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Page not found | Nestlyzer</title><meta name="robots" content="noindex"><meta name="google-adsense-account" content="${ADS_CLIENT}"><link rel="stylesheet" href="/assets/site.css?v=${VERSION}"><script>${STATIC_JS}</script></head><body>${header(false)}<main class="page"><h1>This page moved or never existed</h1><p class="lede">Search every place on the map instead, or start from a country.</p><p><a class="btn btn-primary" href="/#/explore?cc=CH&p=young_family">Open the map</a> <a class="btn" href="/">Home</a></p></main>${footer()}</body></html>`);
if (!FAST) {
const LM = {}; for (const u of SITEMAP) { const h = LASTMOD_SEEN[u], o = LASTMOD_OLD[u]; LM[u] = [h || (o && o[0]) || '', o && o[0] === h ? o[1] : TODAY]; }
fs.mkdirSync(path.dirname(LASTMOD_FILE), { recursive: true }); fs.writeFileSync(LASTMOD_FILE, JSON.stringify(LM));
// one sitemap per kind of page, listed in the sitemap index (only canonical, indexable pages; at most 45,000 URLs per file)
const kindOf = (u) => u.startsWith('/insights/') ? 'insights' : u === '/' || /^\/(method|legal|about|business)\/$/.test(u) ? 'static' : /^\/(best|business)\//.test(u) ? 'profiles' : (u.match(/\//g) || []).length === 2 ? 'countries' : (u.match(/\//g) || []).length === 3 ? 'regions' : 'places';
const groups = {}; for (const u of SITEMAP) (groups[kindOf(u)] = groups[kindOf(u)] || []).push(u);
const urlset = (list) => `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${list.map((u) => `<url><loc>${SITE}${u}</loc><lastmod>${LM[u][1]}</lastmod></url>`).join('\n')}\n</urlset>\n`;
const files = []; for (const k of ['static', 'insights', 'profiles', 'countries', 'regions', 'places']) { const L = groups[k] || []; for (let i = 0; i < L.length; i += 45000) { const part = L.slice(i, i + 45000), name = `sitemap-${k}${i ? '-' + (i / 45000 + 1) : ''}.xml`; write(name, urlset(part)); files.push([name, part.reduce((m, u) => LM[u][1] > m ? LM[u][1] : m, '')]); } }
write('sitemap.xml', `<?xml version="1.0" encoding="UTF-8"?>\n<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${files.map(([n, d]) => `<sitemap><loc>${SITE}/${n}</loc><lastmod>${d}</lastmod></sitemap>`).join('\n')}\n</sitemapindex>\n`);
}
write('robots.txt', `User-agent: *\nAllow: /\n\nSitemap: ${SITE}/sitemap.xml\n`);
write('sw.js', SW_SRC.replace(/__VERSION__/g, VERSION));
write('offline.html', `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Offline | Nestlyzer</title><meta name="robots" content="noindex"><link rel="stylesheet" href="/assets/site.css?v=${VERSION}"></head><body><main class="page"><h1>You are offline</h1><p class="lede">Nestlyzer needs a connection for the first visit to each country. Places you have opened before still work. Check your connection and <a href="/">try again</a>.</p></main></body></html>`);
write('site.webmanifest', JSON.stringify({ id: '/', name: 'Nestlyzer: find where you fit', short_name: 'Nestlyzer', description: `Find where you fit: rank places in ${countries.length} countries for your household or your business site.`, lang: 'en', dir: 'ltr', scope: '/', start_url: '/?source=app', display: 'standalone', display_override: ['standalone', 'minimal-ui'], orientation: 'any', categories: ['lifestyle', 'travel', 'business', 'utilities'], launch_handler: { client_mode: ['navigate-existing', 'auto'] }, handle_links: 'preferred', prefer_related_applications: false, background_color: '#F2F4F0', theme_color: '#0B2E5C',
  shortcuts: [{ name: 'Explore the map', short_name: 'Map', url: '/#/explore?cc=CH&p=young_family' }, { name: 'My shortlist', short_name: 'Shortlist', url: '/#/explore?cc=CH&p=young_family&lt=saved' }, { name: 'Best places for families', short_name: 'Families', url: profilePath('young_family') }, { name: 'Business sites', short_name: 'Business', url: '/#/explore?cc=DE&p=biz_manufacturing' }, { name: 'Insights', short_name: 'Insights', url: '/insights/' }],
  icons: [{ src: '/assets/icon-192.png', sizes: '192x192', type: 'image/png' }, { src: '/assets/icon-512.png', sizes: '512x512', type: 'image/png' }, { src: '/assets/icon-maskable-512.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' }] }, null, 1));
write('CNAME', 'nestlyzer.com\n');
write('.nojekyll', '\n');
// 2.15.1: content fingerprints. SHA-256 of every published data file, so anyone can check that a figure was not changed after release
{ const fp = {}, walk = (d) => { for (const f of fs.readdirSync(path.join(ROOT, d))) { const p = d + '/' + f, st = fs.statSync(path.join(ROOT, p)); if (st.isDirectory()) walk(p); else if (f !== 'fingerprints.json') fp[p] = crypto.createHash('sha256').update(fs.readFileSync(path.join(ROOT, p))).digest('hex'); } };
  // Fingerprint the complete public data tree after page generators have finished.
  if (fs.existsSync(path.join(ROOT, 'data'))) walk('data');
  write('data/fingerprints.json', JSON.stringify({ version: VERSION, algorithm: 'SHA-256', files: fp })); }
write('VERSION.txt', `Nestlyzer ${VERSION}\nbuilt ${new Date().toISOString()}\ndata ${meta.v}\npages ${SITEMAP.length}\n`);
console.log(`built ${SITEMAP.length} pages, index ${Math.round(shell.length / 1024)} KB (js ${Math.round(B.js.length / 1024)} KB, css ${Math.round(B.css.length / 1024)} KB), hero ${hero.kb} KB in ${((Date.now() - t0) / 1000).toFixed(1)}s`);
if (FULLSEO && process.env.NZ_FULL_SEO !== '1') {   // the workflow did not run the expansion itself: run it here, then re-fingerprint
  const { spawnSync } = await import('node:child_process');
  for (const a of [['build/seo_expand.mjs', '--root', '.', '--out', '.', '--cache', '.cache/seo'], ['build/fingerprint_data.mjs']]) {
    const r = spawnSync(process.execPath, a, { cwd: ROOT, stdio: 'inherit', env: process.env });
    if (r.status !== 0) throw new Error('SEO step failed: ' + a[0]);
  }
}
